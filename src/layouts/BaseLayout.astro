---
import BottomNav from "@/components/BottomNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { activeEvent } from "@/config/events/active";
import { withBase } from "@/lib/paths";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  noIndex?: boolean;
}

const {
  title,
  description = activeEvent.description.ko,
  currentPath = "/",
  noIndex = false
} = Astro.props;
const pageTitle = title
  ? title + " | Nextbridge 현장지원"
  : activeEvent.shortTitle.ko + " | 현장지원";
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const logoPath = withBase("/logo-gyeonggi.png");
const manifestPath = withBase("/manifest.webmanifest");
const serviceWorkerPath = withBase("/sw.js");
const apiBase = import.meta.env.PUBLIC_QUESTION_API_BASE_URL ?? "";
const apiOrigin = apiBase ? new URL(apiBase).origin : "";
const needsLiveConnection =
  currentPath.startsWith("/questions/") || currentPath.startsWith("/admin/");
const needsTurnstile =
  activeEvent.status === "published" && Astro.url.pathname.endsWith("/questions/");
const contentSecurityPolicy = [
  "default-src 'self'",
  "base-uri 'self'",
  `connect-src 'self'${apiOrigin ? ` ${apiOrigin}` : ""} https://challenges.cloudflare.com`,
  "font-src 'self' data:",
  "form-action 'self'",
  "frame-src https://challenges.cloudflare.com",
  "img-src 'self' data: https://staticmap.kakao.com",
  "manifest-src 'self'",
  "object-src 'none'",
  "script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com",
  "style-src 'self' 'unsafe-inline'",
  "worker-src 'self'",
  "upgrade-insecure-requests"
].join("; ");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0B817A" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="no-referrer" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={logoPath} />
    <link rel="apple-touch-icon" href={logoPath} />
    <link rel="manifest" href={manifestPath} />
    {
      needsLiveConnection && apiOrigin && (
        <>
          <link rel="dns-prefetch" href={apiOrigin} />
          <link rel="preconnect" href={apiOrigin} crossorigin />
        </>
      )
    }
    {
      needsTurnstile && (
        <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-rail" aria-hidden="true"></div>
    <a class="skip-link" href="#main-content">본문으로 바로가기</a>
    <SiteHeader currentPath={currentPath} />
    <div class="network-status" data-network-status role="status" aria-live="polite" hidden>
      인터넷 연결이 끊겼습니다. 질문 접수와 답변 확인은 연결 후 이용해 주세요.
    </div>
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <BottomNav currentPath={currentPath} />
    <script is:inline define:vars={{ serviceWorkerPath }}>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register(serviceWorkerPath).catch(() => {
            // Core information remains available without the service worker.
          });
        });
      }
    </script>
    <script is:inline>
      const networkStatus = document.querySelector("[data-network-status]");
      const syncNetworkStatus = () => {
        if (networkStatus instanceof HTMLElement) networkStatus.hidden = navigator.onLine;
      };
      window.addEventListener("online", syncNetworkStatus);
      window.addEventListener("offline", syncNetworkStatus);
      syncNetworkStatus();
    </script>
  </body>
</html>
