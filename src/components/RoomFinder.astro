---
import { activeEvent } from "@/config/events/active";
---

<section class="room-finder" data-room-finder>
  <label class="search-field">
    <span>교과명 또는 개발 과목으로 검색</span>
    <span class="search-control">
      <i aria-hidden="true">⌕</i>
      <input
        type="search"
        inputmode="search"
        autocomplete="off"
        placeholder="예: 수학, 문학, 그래픽"
        data-room-search
      />
    </span>
  </label>
  <p class="result-count" aria-live="polite" data-room-count>
    전체 {activeEvent.rooms.length}개 협의실
  </p>
  <div class="room-grid" data-room-list>
    {
      activeEvent.rooms.map((room) => (
        <article
          class="room-card"
          data-room
          data-search={[
            room.subject.ko,
            room.course.ko,
            room.room.ko,
            room.floor.ko,
            ...room.keywords
          ]
            .join(" ")
            .toLocaleLowerCase("ko")}
        >
          <div>
            <p>{room.floor.ko}</p>
            <strong>{room.room.ko}</strong>
          </div>
          <h2>{room.subject.ko}</h2>
          <p>{room.course.ko}</p>
        </article>
      ))
    }
  </div>
  <p class="empty-state" data-room-empty hidden>
    검색 결과가 없습니다. 교과명이나 과목명을 다시 확인해 주세요.
  </p>
  <p class="inline-notice neutral">
    <span aria-hidden="true">i</span>
    협의실은 현장 상황에 따라 변경될 수 있습니다. 최신 현장 안내를 우선해 주세요.
  </p>
</section>

<script>
  const finders = document.querySelectorAll<HTMLElement>("[data-room-finder]");
  for (const finder of finders) {
    const input = finder.querySelector<HTMLInputElement>("[data-room-search]");
    const rows = [...finder.querySelectorAll<HTMLElement>("[data-room]")];
    const count = finder.querySelector<HTMLElement>("[data-room-count]");
    const empty = finder.querySelector<HTMLElement>("[data-room-empty]");
    if (!input) continue;

    input.addEventListener("input", () => {
      const query = input.value.trim().toLocaleLowerCase("ko");
      let visible = 0;
      for (const row of rows) {
        const matches = query.length === 0 || (row.dataset.search ?? "").includes(query);
        row.hidden = !matches;
        if (matches) visible += 1;
      }
      if (count)
        count.textContent = query ? visible + "개 검색 결과" : "전체 " + visible + "개 협의실";
      if (empty) empty.hidden = visible > 0;
    });
  }
</script>
