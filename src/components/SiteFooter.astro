---
import { activeEvent } from "@/config/events/active";
import { withBase } from "@/lib/paths";
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-brand">
      <img src={withBase("/logo-symbol.png")} width="42" height="42" alt="" />
      <p>
        <strong>{activeEvent.organizer.ko}</strong>
        <span>{activeEvent.year} 경기 성취평가</span>
      </p>
    </div>
    <p class="footer-note">질문에 개인정보·민감정보를 입력하지 마세요.</p>
    <a href={withBase("/admin/")} class="operator-link">운영진 화면</a>
  </div>
</footer>
