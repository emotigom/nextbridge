---
import { activeEvent } from "@/config/events/active";
import { withBase } from "@/lib/paths";
---

<section class="event-hero section-shell" aria-labelledby="event-title">
  <div class="event-hero-copy">
    <p class="event-year">{activeEvent.year}</p>
    <h1 id="event-title">
      <span class="event-title-primary">경기 성취평가</span>
      <span class="event-title-secondary">표준화 평가도구 개발</span>
      <span class="event-title-tertiary">합숙 워크숍</span>
    </h1>
    <dl class="event-meta">
      <div>
        <dt>일자</dt>
        <dd>{activeEvent.dates.display.ko}</dd>
      </div>
      <div>
        <dt>장소</dt>
        <dd>{activeEvent.venue.name.ko}</dd>
      </div>
    </dl>
    <p class="event-organizer">{activeEvent.organizer.ko}</p>
    <nav class="hero-actions" aria-label="행사 바로가기">
      <a class="button button-primary" href={withBase("/schedule/")}>전체 일정 보기</a>
      <a class="button button-secondary" href={withBase("/questions/")}>운영진에게 질문</a>
    </nav>
  </div>
</section>
