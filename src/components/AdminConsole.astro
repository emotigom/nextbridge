---
import { activeEvent } from "@/config/events/active";

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const publishableKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? "";
const apiBase = import.meta.env.PUBLIC_QUESTION_API_BASE_URL ?? "";
const isConnected = Boolean(supabaseUrl && publishableKey && apiBase);
---

<section
  class="admin-console"
  data-admin-console
  data-supabase-url={supabaseUrl}
  data-publishable-key={publishableKey}
  data-api-base={apiBase}
  data-event-slug={activeEvent.slug}
>
  <div class="workflow-summary" aria-label="질문 처리 흐름">
    <article><span>01</span><strong>접수</strong><p>새 질문과 알림을 확인합니다.</p></article>
    <article><span>02</span><strong>확인 중</strong><p>담당자가 내용을 검토합니다.</p></article>
    <article><span>03</span><strong>답변 완료</strong><p>답변과 완료 알림을 보냅니다.</p></article>
  </div>

  {
    !isConnected && (
      <div class="setup-banner" role="note">
        <strong>운영 시스템 연결 전</strong>
        <p>
          정보 구조와 인증 경계만 준비된 상태입니다. 실제 질문 원문과 연락처는 Supabase 연결 후
          권한이 등록된 운영진에게만 표시됩니다.
        </p>
      </div>
    )
  }

  <form class="operator-login" data-operator-login hidden={!isConnected}>
    <div>
      <p class="eyebrow">OPERATOR SIGN IN</p>
      <h2>운영진 로그인</h2>
      <p>Supabase Auth 계정과 운영진 권한이 모두 확인되어야 접근할 수 있습니다.</p>
    </div>
    <label>
      <span>이메일</span>
      <input type="email" name="email" autocomplete="username" required />
    </label>
    <label>
      <span>비밀번호</span>
      <input type="password" name="password" autocomplete="current-password" required />
    </label>
    <div class="button-row">
      <button class="button button-primary" type="submit">로그인</button>
      <button class="button button-secondary" type="button" data-request-password-reset>
        비밀번호 설정·재설정 메일 받기
      </button>
    </div>
    <p class="form-status" role="status" aria-live="polite" data-admin-message></p>
  </form>

  <form class="operator-login" data-password-setup hidden>
    <div>
      <p class="eyebrow">SECURE ACCOUNT SETUP</p>
      <h2>운영진 비밀번호 설정</h2>
      <p>
        초대 또는 비밀번호 재설정 링크가 확인됐습니다. 이 화면에서만 사용할 새 비밀번호를 입력해
        주세요.
      </p>
    </div>
    <label>
      <span>새 비밀번호</span>
      <input
        type="password"
        name="password"
        autocomplete="new-password"
        minlength="12"
        aria-describedby="operator-password-help"
        required
      />
    </label>
    <label>
      <span>새 비밀번호 확인</span>
      <input
        type="password"
        name="passwordConfirm"
        autocomplete="new-password"
        minlength="12"
        required
      />
    </label>
    <p id="operator-password-help" class="field-help">
      12자 이상을 권장하며 다른 서비스에서 사용하지 않는 비밀번호로 설정하세요.
    </p>
    <button class="button button-primary" type="submit">비밀번호 저장</button>
    <p class="form-status" role="status" aria-live="polite" data-password-setup-message></p>
  </form>

  <section class="operator-workspace" data-operator-workspace hidden>
    <header>
      <div>
        <p class="eyebrow">QUESTION DESK</p>
        <h2>질문 처리함</h2>
      </div>
      <div class="button-row">
        <button class="button button-secondary" type="button" data-refresh-questions>
          새로고침
        </button>
        <button class="button button-secondary" type="button" data-operator-logout>
          로그아웃
        </button>
      </div>
    </header>
    <div class="operator-session-summary">
      <p>
        <span>현재 권한</span>
        <strong data-operator-role>확인 중</strong>
      </p>
      <p data-role-guidance>권한을 확인하고 있습니다.</p>
      <p>
        <span>마지막 확인</span>
        <time data-last-checked>아직 확인하지 않음</time>
      </p>
    </div>
    <div class="admin-status-filters" role="group" aria-label="질문 상태 필터">
      <button type="button" data-question-filter="all" aria-pressed="true">
        전체 <span data-filter-count="all">0</span>
      </button>
      <button type="button" data-question-filter="received" aria-pressed="false">
        접수 <span data-filter-count="received">0</span>
      </button>
      <button type="button" data-question-filter="reviewing" aria-pressed="false">
        확인 중 <span data-filter-count="reviewing">0</span>
      </button>
      <button type="button" data-question-filter="answered" aria-pressed="false">
        답변 완료 <span data-filter-count="answered">0</span>
      </button>
    </div>
    <p class="form-status" role="status" aria-live="polite" data-workspace-message></p>
    <div class="admin-question-list" data-admin-question-list></div>
  </section>
</section>

<script>
  import "@/scripts/operator-console";
</script>
