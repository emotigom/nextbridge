---
import { activeEvent } from "@/config/events/active";

const venueName = activeEvent.venue.name.ko;
const venueAddress = activeEvent.venue.address.ko;
const venueLatitude = 37.1472473;
const venueLongitude = 127.4202277;
const venueLabel = encodeURIComponent(venueName);
const venueQuery = encodeURIComponent(`${venueName} ${venueAddress}`);
const kakaoStaticMapUrl =
  "https://staticmap.kakao.com/map/mapservice?FORMAT=PNG&SCALE=2.5&MX=593230&MY=1013627&S=0&IW=504&IH=310&LANG=0&COORDSTM=WCONGNAMUL&logo=kakao_logo";
const kakaoMapUrl =
  `https://map.kakao.com/link/map/${venueLabel},${venueLatitude},${venueLongitude}`;
const kakaoDirectionsUrl =
  `https://map.kakao.com/link/to/${venueLabel},${venueLatitude},${venueLongitude}`;
const tmapDrivingUrl =
  `https://www.tmap.co.kr/tmap2/mobile/route.jsp?name=${venueLabel}&lon=${venueLongitude}&lat=${venueLatitude}`;
const naverTransitUrl =
  `nmap://route/public?dlat=${venueLatitude}&dlng=${venueLongitude}&dname=${venueLabel}&appname=https%3A%2F%2Femotigom.github.io%2Fnextbridge`;
const naverMapUrl = `https://map.naver.com/p/search/${venueQuery}`;
---

<section class="visit-map-card" aria-labelledby="visit-map-title">
  <div class="visit-map-frame">
    <a
      class="visit-map-link"
      href={kakaoMapUrl}
      target="_blank"
      rel="noreferrer"
      aria-label={venueName + " 카카오맵 크게 보기"}
    >
      <img
        src={kakaoStaticMapUrl}
        width="504"
        height="310"
        alt={venueName + " 주변 카카오맵"}
        loading="eager"
        decoding="async"
      />
      <span class="visit-map-marker" aria-hidden="true"></span>
      <span class="visit-map-open">카카오맵 크게 보기</span>
    </a>
  </div>

  <div class="visit-map-summary">
    <p class="eyebrow">행사장</p>
    <h2 id="visit-map-title">{venueName}</h2>
    <address>
      <strong>{venueAddress}</strong>
      <a href={"tel:" + activeEvent.venue.phone}>{activeEvent.venue.phone}</a>
    </address>

    <nav class="route-actions" aria-label="현재 위치에서 길찾기">
      <a
        class="route-button route-driving"
        href={tmapDrivingUrl}
        target="_blank"
        rel="noreferrer"
      >
        TMAP 자동차
      </a>
      <a
        class="route-button route-transit"
        href={naverTransitUrl}
        data-route-fallback={naverMapUrl}
      >
        네이버지도 대중교통
      </a>
    </nav>

    <div class="map-provider-links" aria-label="다른 지도 서비스">
      <a href={kakaoDirectionsUrl} target="_blank" rel="noreferrer">카카오맵 길찾기</a>
    </div>
  </div>
</section>

<div class="visit-grid">
  <article class="visit-card location-panel">
    <h2>도착·등록</h2>
    <dl>
      <div><dt>주소</dt><dd>{venueAddress}</dd></div>
      <div><dt>등록</dt><dd>{activeEvent.venue.registrationLocation.ko}</dd></div>
      <div><dt>이동</dt><dd>{activeEvent.venue.transportNote.ko}</dd></div>
    </dl>
    <div class="button-row">
      <a
        class="button button-primary"
        href={activeEvent.venue.website}
        target="_blank"
        rel="noreferrer"
      >
        센터 홈페이지
      </a>
      <button
        class="button button-secondary"
        type="button"
        data-copy-address={venueAddress}
      >
        주소 복사
      </button>
    </div>
    <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
  </article>

  <article class="visit-card checklist-panel">
    <h2>방문 전 준비물</h2>
    <ul class="check-list">
      {
        activeEvent.preparation.map((item) => (
          <li>
            <>
              <span aria-hidden="true">✓</span>
              <p>{item.ko}</p>
            </>
          </li>
        ))
      }
    </ul>
  </article>
</div>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-address]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
  copyButton?.addEventListener("click", async () => {
    const address = copyButton.dataset.copyAddress ?? "";
    try {
      await navigator.clipboard.writeText(address);
      if (copyStatus) copyStatus.textContent = "주소를 복사했습니다.";
    } catch {
      if (copyStatus) copyStatus.textContent = "주소를 길게 눌러 직접 복사해 주세요.";
    }
  });

  const naverRoute = document.querySelector<HTMLAnchorElement>("[data-route-fallback]");
  naverRoute?.addEventListener("click", (event) => {
    const fallbackUrl = naverRoute.dataset.routeFallback;
    if (!fallbackUrl) return;

    event.preventDefault();
    let appOpened = false;
    const onVisibilityChange = () => {
      if (document.hidden) appOpened = true;
    };

    document.addEventListener("visibilitychange", onVisibilityChange, { once: true });
    window.location.href = naverRoute.href;

    window.setTimeout(() => {
      document.removeEventListener("visibilitychange", onVisibilityChange);
      if (!appOpened && document.visibilityState === "visible") {
        window.location.href = fallbackUrl;
      }
    }, 1400);
  });
</script>
