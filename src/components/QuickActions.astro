---
import { withBase } from "@/lib/paths";

const actions = [
  {
    href: "/schedule/",
    number: "01",
    title: "3일 전체 일정"
  },
  {
    href: "/rooms/",
    number: "02",
    title: "내 교과 협의실"
  },
  {
    href: "/visit/",
    number: "03",
    title: "오시는 길·준비물"
  },
  {
    href: "/questions/",
    number: "04",
    title: "질문·답변 확인"
  }
];
---

<nav class="quick-actions section-shell" aria-label="현장 빠른 메뉴">
  {
    actions.map((action) => (
      <a href={withBase(action.href)}>
        <span class="quick-number">{action.number}</span>
        <span>
          <strong>{action.title}</strong>
        </span>
        <i aria-hidden="true">→</i>
      </a>
    ))
  }
</nav>
