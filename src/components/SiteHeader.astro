---
import { activeEvent } from "@/config/events/active";
import { siteNavigation } from "@/config/navigation";
import { withBase } from "@/lib/paths";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand-lockup" href={withBase("/")} aria-label="행사 현장지원 홈">
      <img src={withBase("/logo-symbol.png")} width="48" height="48" alt="" />
      <span>
        <strong>{activeEvent.organizer.ko}</strong>
        <small>{activeEvent.year} 경기 성취평가</small>
      </span>
    </a>
    <nav class="desktop-nav" aria-label="주요 메뉴">
      {
        siteNavigation.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={currentPath === link.href ? "page" : undefined}
          >
            {link.desktopLabel}
          </a>
        ))
      }
    </nav>
  </div>
</header>
