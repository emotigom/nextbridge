  <div class="page-content section-shell">
    <header class="page-intro">
      <p class="eyebrow">404</p>
      <h1>페이지를 찾을 수 없습니다.</h1>
      <p>행사 안내 홈으로 이동해 주세요.</p>
    </header>
    <a class="button button-primary" href={withBase("/")}>행사 안내 홈</a>
  </div>
</BaseLayout>
