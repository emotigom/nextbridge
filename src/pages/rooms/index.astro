---
import PageIntro from "@/components/PageIntro.astro";
import RoomFinder from "@/components/RoomFinder.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="교과별 협의실" currentPath="/rooms/">
  <div class="page-content section-shell">
    <PageIntro
      eyebrow="ROOM FINDER"
      title="내 교과 협의실"
      description="교과명이나 개발 과목을 입력하면 층과 협의실을 바로 찾을 수 있습니다."
    />
    <RoomFinder />
  </div>
</BaseLayout>
