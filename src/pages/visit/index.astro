---
import PageIntro from "@/components/PageIntro.astro";
import VisitDetails from "@/components/VisitDetails.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="오시는 길과 준비물" currentPath="/visit/">
  <div class="page-content section-shell">
    <PageIntro
      eyebrow="VISIT GUIDE"
      title="오시는 길과 준비물"
      description="센터 주소, 등록 장소, 이동 안내와 방문 전에 챙길 항목을 확인하세요."
    />
    <VisitDetails />
  </div>
</BaseLayout>
