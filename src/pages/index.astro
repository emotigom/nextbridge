---
import AnnouncementList from "@/components/AnnouncementList.astro";
import EventHero from "@/components/EventHero.astro";
import FaqList from "@/components/FaqList.astro";
import QuickActions from "@/components/QuickActions.astro";
import ScheduleList from "@/components/ScheduleList.astro";
import SignatureGuide from "@/components/SignatureGuide.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/paths";
---

<BaseLayout currentPath="/">
  <EventHero />
  <QuickActions />
  <SignatureGuide />
  <AnnouncementList />
  <section class="content-section section-shell">
    <header class="section-heading">
      <div>
        <h2>첫날 일정</h2>
      </div>
    </header>
    <ScheduleList compact />
    <p style="margin: 20px 0 0;">
      <a class="button button-secondary" href={withBase("/schedule/")}>3일 전체 일정 보기</a>
    </p>
  </section>
  <section class="content-section section-shell">
    <header class="section-heading compact-heading">
      <div>
        <h2>자주 묻는 질문</h2>
      </div>
    </header>
    <FaqList />
  </section>
</BaseLayout>
