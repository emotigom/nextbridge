---
import FaqList from "@/components/FaqList.astro";
import PageIntro from "@/components/PageIntro.astro";
import QuestionForm from "@/components/QuestionForm.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/paths";
---

<BaseLayout title="운영진에게 질문" currentPath="/questions/">
  <div class="page-content section-shell">
    <PageIntro
      eyebrow="QUESTION DESK"
      title="운영진에게 질문"
      description="로그인 없이 질문을 남기고 접수번호로 처리 상태와 답변을 확인할 수 있습니다."
    />
    <div class="question-page-grid">
      <QuestionForm />
      <aside class="question-aside">
        <p class="eyebrow">BEFORE YOU ASK</p>
        <h2>빠른 확인</h2>
        <ul>
          <li><span>1</span><p>일정·서명·협의실은 상단 메뉴에서 먼저 확인해 주세요.</p></li>
          <li><span>2</span><p>질문에는 불필요한 개인정보와 민감정보를 적지 마세요.</p></li>
          <li><span>3</span><p>접수번호나 비공개 링크를 안전하게 보관해 주세요.</p></li>
        </ul>
        <a class="button button-secondary" href={withBase("/questions/status/")}>
          접수한 질문 확인
        </a>
      </aside>
    </div>
  </div>
  <section class="content-section section-shell">
    <header class="section-heading compact-heading">
      <div><p class="eyebrow">FAQ</p><h2>질문 전 확인</h2></div>
      <p>자주 묻는 질문에서 바로 답을 찾을 수 있습니다.</p>
    </header>
    <FaqList />
  </section>
</BaseLayout>
