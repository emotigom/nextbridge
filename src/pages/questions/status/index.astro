---
import PageIntro from "@/components/PageIntro.astro";
import QuestionStatus from "@/components/QuestionStatus.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="질문 답변 확인" currentPath="/questions/" noIndex>
  <div class="page-content section-shell narrow-page">
    <PageIntro
      eyebrow="PRIVATE STATUS"
      title="질문 답변 확인"
      description="접수번호 또는 비공개 확인 링크를 이용해 처리 상태와 운영진 답변을 확인하세요."
    />
    <QuestionStatus />
  </div>
</BaseLayout>
