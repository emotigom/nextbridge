{
  "name": "@nextbridge/event-support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit && tsc -p supabase/functions/tsconfig.check.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:scan": "node scripts/security-scan.mjs",
    "security:deps": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run security:scan && npm run security:deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "astro": "7.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-plugin-astro": "1.6.0",
    "globals": "17.10.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
